rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /ota/android/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Keep default locked down. Merge with your existing storage rules before production deploy.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
